  "type": "module",
  "license": "MIT",
  "author": "Zunnorain",
  "homepage": "https://github.com/zunnorainuzair/freepi-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zunnorainuzair/freepi-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/zunnorainuzair/freepi-bridge/issues"
  },
  "bin": {
    "freepi-bridge": "bin/freepi-bridge.js",
    "freep": "bin/freepi-bridge.js",
    "fpb": "bin/freepi-bridge.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/freepi-bridge.js serve",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "free-pi",
    "freepi",
    "dsh",
